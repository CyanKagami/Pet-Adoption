FROM node:20-alpine

WORKDIR /app

# คัดลอก package.json และ package-lock.json
COPY package*.json ./

RUN npm ci

# คัดลอกโค้ด Next.js ทั้งหมด
COPY . .

COPY entrypoint.sh /app/entrypoint.sh
RUN sha256sum package-lock.json | cut -d ' ' -f 1 > node_modules/.package-lock.sha256 \
    && chmod +x /app/entrypoint.sh

EXPOSE 3000

# Build and run Next.js in production mode
ENTRYPOINT ["sh", "/app/entrypoint.sh"]