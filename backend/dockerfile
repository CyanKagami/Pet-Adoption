FROM node:22-alpine

RUN apk add --no-cache netcat-openbsd

WORKDIR /app

# 1. Copy package files and prisma schema first so dependencies/generations have access to the schema
COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci

# 2. Copy the rest of your source code
COPY . .

COPY entrypoint.sh /app/entrypoint.sh
RUN sha256sum package-lock.json | cut -d ' ' -f 1 > node_modules/.package-lock.sha256
RUN chmod +x /app/entrypoint.sh

EXPOSE 5000

ENTRYPOINT ["sh", "/app/entrypoint.sh"]